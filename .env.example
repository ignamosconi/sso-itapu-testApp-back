# ───────────── App ─────────────
NODE_ENV=development
PORT=3001
# URL pública de ESTE backend (se usa en el chequeo de Origin y para Swagger)
APP_PUBLIC_URL=http://localhost:3001
# Origen del front (CORS + chequeo de Origin). Sin barra final.
FRONTEND_ORIGIN=http://localhost:5173

# ───────────── Base de datos (Postgres en Docker) ─────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=itapu_exams
DB_USER=itapu
DB_PASSWORD=cambiame
# true en Neon y otros Postgres gestionados (exigen SSL). En Docker local: false.
DB_SSL=false
# El esquema se maneja SOLO con migraciones (npm run migration:run).
# true = la app aplica las migraciones pendientes al arrancar (cómodo en desarrollo).
DB_MIGRATIONS_RUN=true

# ───────────── ITAPU SSO (ver src/sso/README.md) ─────────────
# URL base del SSO. Es el "iss" que tienen que tener los JWT.
SSO_BASE_URL=http://localhost:3000
# Opcional: si el iss de los JWT difiere de SSO_BASE_URL
# SSO_ISSUER=http://localhost:3000
# Credenciales del mail "Credenciales de integración"
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Tiene que coincidir EXACTAMENTE con una Redirect URI registrada (incluida la barra final)
SSO_REDIRECT_URI=http://localhost:5173/
# Tema del popup de login: dark | light
SSO_THEME=dark
SSO_HTTP_TIMEOUT_MS=8000

# ───────────── Política de acceso ─────────────
# Cargos (tal cual los devuelve GET /sso/info/domain-roles) que ven el panel de administración.
# Separados por coma. Al arrancar, el backend avisa si alguno no existe en el SSO.
STAFF_CARGOS=Profesor
# Cuánto se cachean cargos/especialidades del SSO
DIRECTORY_CACHE_TTL_SECONDS=300

# ───────────── Sesión ─────────────
SESSION_COOKIE_NAME=itapu_exams_sid
# El SSO corta a los 3 días de todos modos
SESSION_MAX_AGE_HOURS=72
# true en producción (HTTPS)
COOKIE_SECURE=false

# ───────────── Archivos ─────────────
STORAGE_DIR=./storage
MAX_PDF_SIZE_MB=20
